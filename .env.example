[TEMPLATE]
APP_NAME="Agent Finance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Vite dev server origin used by the Docker `hmr` profile (`npm run dev`).
# VITE_DEV_SERVER_URL=http://localhost:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Database
# Local (no Docker): SQLite. Docker Compose: MySQL (service "mysql").
# Inside Docker, compose overrides DB_HOST to "mysql".
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agent_finance
DB_USERNAME=agent_finance
DB_PASSWORD=secret
# Host port for the Docker MySQL service (containers always use 3306).
# Defaults to 33061 to avoid clashes with a locally installed MySQL.
DB_HOST_PORT=33061

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------
# Queue & cache
# Docker: redis (the "queue" service consumes it).
# Local dev without Redis: switch both to "database".
# ------------------------------------------------------------------
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@agentfinance.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Object storage (S3-compatible)
# Local dev: "local" private disk. Production/SIHANDAL-grade storage:
# set FILESYSTEM_DISK=s3 and point AWS_* at S3 or MinIO
# (docker compose --profile storage runs MinIO at localhost:9000).
# ------------------------------------------------------------------
# FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=agent-finance-documents
AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_ENDPOINT=http://minio:9000

# ------------------------------------------------------------------
# Documents / ingestion (mirrors config/agent-finance.php)
# ------------------------------------------------------------------
DOCUMENTS_MAX_SIZE_KB=20480
DOCUMENTS_DISK=local

# ------------------------------------------------------------------
# AI layer (provider is replaceable; see config/agent-finance.php)
# Only the configured provider's key is required. Never commit keys.
# ------------------------------------------------------------------
AI_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# OpenAI-compatible endpoint for self-hosted / local models.
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=

# ------------------------------------------------------------------
# OCR
# tesseract runs in the app container; cloud providers need keys.
# ------------------------------------------------------------------
OCR_DRIVER=tesseract
GOOGLE_CLOUD_VISION_KEY=

# ------------------------------------------------------------------
# SIHANDAL V2 integration
# Base URL of the existing SIHANDAL V2 REST API (system of record).
# Leave empty in development to use the fake client (no HTTP calls).
# ------------------------------------------------------------------
SIHANDAL_BASE_URL=
SIHANDAL_API_KEY=
SIHANDAL_TIMEOUT=15
SIHANDAL_CACHE_TTL=300

# ------------------------------------------------------------------
# Validation thresholds (0-1)
# ------------------------------------------------------------------
VALIDATION_LOW_CONFIDENCE=0.60
VALIDATION_REVIEW_CONFIDENCE=0.85

VITE_APP_NAME="${APP_NAME}"
